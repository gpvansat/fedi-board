# ---- Database (Drizzle + libSQL/Turso) ----
# Local dev: a SQLite file (tables are auto-created). Prod: libsql://<db>.turso.io
DATABASE_URL=file:./local.db
# Turso only
DATABASE_AUTH_TOKEN=

# ---- Payments ----
# lnurl  = invoices from OPERATOR_LIGHTNING_ADDRESS via LNURL-pay (+ LUD-21 verify if offered)
# lnbits = invoices from an LNbits wallet (invoice/read key only)
# mock   = DEV ONLY, auto-settles; refused when NODE_ENV=production
PAYMENT_BACKEND=lnurl
OPERATOR_LIGHTNING_ADDRESS=you@your-wallet.example
# If the address has no LUD-21 verify URL, accept sha256(preimage)==payment_hash as proof
ACCEPT_PREIMAGE_PROOF=true
# LNBITS_URL=https://legend.lnbits.com
# LNBITS_INVOICE_KEY=

POST_PRICE_SATS=500
BUMP_PRICE_SATS=100

# ---- Auth / moderation ----
# Public origin; NIP-98 `u` tags must match it (recommended behind proxies)
PUBLIC_BASE_URL=
# Comma-separated hex pubkeys whose single report hides a listing
ADMIN_PUBKEYS=
REPORT_HIDE_THRESHOLD=3
